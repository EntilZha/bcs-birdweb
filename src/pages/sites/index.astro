---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SitesMap from "../../components/SitesMap.astro";
import SiteFilter, { type SiteEntry } from "../../components/SiteFilter.tsx";

const base = import.meta.env.BASE_URL;
const sites = (await getCollection("sites")).sort((a, b) => a.data.name.localeCompare(b.data.name));

// Names and regions only. Shipping the prose too would be most of a megabyte for a filter
// that matches on names.
const entries: SiteEntry[] = sites.map((site) => ({
  slug: site.id,
  name: site.data.name,
  ecoregions: [...site.data.ecoregions],
  number: site.data.number,
  county: site.data.geocode_source === "confirmed" ? site.data.county : null,
}));
---

<Layout
  title="Birding sites — BirdWeb"
  description={`${sites.length} places to go birding in Washington, with habitat notes, the birds to expect, and directions.`}
>
  <h1 class="text-3xl font-bold text-brand">Birding sites</h1>
  <p class="mt-1 text-ink">
    {sites.length} places to go birding across Washington, grouped by ecoregion.
  </p>
  <p class="mt-2 flex flex-wrap gap-x-4 text-sm">
    <a href={`${base}about-birding-sites/`} class="text-brand font-semibold hover:underline"
      >About these sites &rarr;</a
    >
    <a href={`${base}resources/`} class="text-brand font-semibold hover:underline"
      >Birding resources &rarr;</a
    >
  </p>

  <div class="mt-6">
    <SitesMap sites={sites} />
  </div>

  <div class="mt-8">
    <SiteFilter sites={entries} base={base} client:load />
  </div>
</Layout>
