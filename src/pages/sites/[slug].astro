---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Prose from "../../components/Prose.astro";
import { siteImage } from "../../lib/images";
import { ECOREGION_NAME } from "../../config/ecoregions";

export async function getStaticPaths() {
  const sites = await getCollection("sites");
  return sites.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const base = import.meta.env.BASE_URL;
const hero = data.photos[0] ? siteImage(entry.id, data.photos[0].file) : null;

const SECTIONS: Array<[keyof typeof data.sections, string]> = [
  ["site", "The Site"],
  ["birds", "The Birds"],
  ["directions", "Directions and Suggestions"],
  ["references", "References"],
];
const sections = SECTIONS.filter(([key]) => data.sections[key]);
---

<Layout title={`${data.name} — BirdWeb`} description={`Birding at ${data.name}: habitat, the birds to expect, and directions. From Birds Connect Seattle's guide to the birds of Washington.`}>
  <nav class="text-xs text-ink-muted mb-4">
    <a href={`${base}sites/`} class="hover:text-brand hover:underline">Birding Sites</a>
  </nav>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:items-start">
    <div>
      <h1 class="text-3xl sm:text-4xl font-bold text-brand leading-tight">{data.name}</h1>
      <p class="mt-2 flex flex-wrap gap-2">
        {data.ecoregions.map((slug) => (
          <a href={`${base}ecoregions/${slug}/`} class="inline-block rounded-full bg-brand/10 px-3 py-1 text-xs font-semibold text-brand hover:bg-pop transition">
            {ECOREGION_NAME[slug]}
          </a>
        ))}
      </p>
      {data.number && <p class="mt-2 text-xs text-ink-faint">Site {data.number} on the BirdWeb ecoregion map</p>}
    </div>
    {hero && (
      <figure class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-black/5">
        <Image src={hero} alt={data.photos[0].caption || data.name} widths={[400, 800]} sizes="(min-width: 1024px) 36rem, 100vw" class="w-full object-cover" loading="eager" />
        {data.photos[0].credit.name && (
          <figcaption class="px-4 py-2 text-xs text-ink-muted">&copy; {data.photos[0].credit.name}</figcaption>
        )}
      </figure>
    )}
  </div>

  <div class="mt-9 max-w-3xl space-y-7">
    {sections.map(([key, label]) => (
      <section>
        <h2 class="text-xl font-bold text-brand mb-2">{label}</h2>
        <Prose text={data.sections[key]!} />
      </section>
    ))}
  </div>

  <p class="mt-10 text-xs text-ink-faint">
    Site account &copy; Birds Connect Seattle. Archived from
    <a href={data.source.url} target="_blank" rel="noopener" class="underline decoration-sage underline-offset-2 hover:text-brand">the original BirdWeb</a>
    on {data.source.archived}.
  </p>
</Layout>
