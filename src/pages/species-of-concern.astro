---
import { getCollection, getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Prose from "../components/Prose.astro";
import SpeciesCard from "../components/SpeciesCard.astro";
import { taxonomicSort, displayName } from "../lib/species";

const base = import.meta.env.BASE_URL;
const page = await getEntry("pages", "species-of-concern");
const concern = (await getCollection("species"))
  .filter((s) => s.data.species_of_concern)
  .sort((a, b) => taxonomicSort(a.data, b.data));
---

<Layout
  title="Species of Special Concern — BirdWeb"
  description={`${concern.length} Washington bird species carry a federal, state or conservation-organization designation of concern.`}
>
  <h1 class="text-3xl font-bold text-brand">{page?.data.title ?? "Species of Special Concern"}</h1>
  <p class="mt-1 text-ink">
    {concern.length} of Washington's birds carry a designation of concern.
  </p>

  {page?.data.body && (
    <div class="mt-4 max-w-3xl">
      <Prose text={page.data.body} />
    </div>
  )}

  <h2 class="mt-9 text-xl font-bold text-brand">The species</h2>
  <ul class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 p-0 list-none">
    {concern.map((entry) => <SpeciesCard entry={entry} />)}
  </ul>

  <p class="mt-8 text-xs text-ink-faint">
    Designations as recorded by the BCS Science Committee when these accounts were written.
    Conservation listings change; check the
    <a href="https://wdfw.wa.gov/species-habitats/at-risk" target="_blank" rel="noopener"
      class="underline decoration-sage underline-offset-2 hover:text-brand">WDFW at-risk species list</a>
    for the current status.
  </p>
</Layout>
