---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import SpeciesCard from "../../../components/SpeciesCard.astro";
import SearchBox from "../../../components/SearchBox.tsx";
import IndexToggle from "../../../components/IndexToggle.astro";
import { buildSearchIndex } from "../../../lib/search";
import { alphabeticalSort, displayName } from "../../../lib/species";

const base = import.meta.env.BASE_URL;
const species = (await getCollection("species")).sort((a, b) => alphabeticalSort(a.data, b.data));
const sites = await getCollection("sites");
const index = buildSearchIndex(species, sites);

// Grouped by first letter of the *displayed* name, which is the one on the card — an
// account that leads with its historic name files under that, not under the modern one.
const groups: Array<{ letter: string; members: typeof species }> = [];
for (const entry of species) {
  const letter = displayName(entry.data).charAt(0).toUpperCase();
  let group = groups.find((g) => g.letter === letter);
  if (!group) {
    group = { letter, members: [] };
    groups.push(group);
  }
  group.members.push(entry);
}
---

<Layout
  title="All birds A–Z — BirdWeb"
  description={`All ${species.length} bird species on the Washington state checklist, listed alphabetically.`}
>
  <h1 class="text-3xl font-bold text-brand">Birds of Washington</h1>
  <p class="mt-1 text-ink">{species.length} species, alphabetically.</p>

  <div class="mt-4"><IndexToggle current="alpha" /></div>

  <div class="mt-5 max-w-xl">
    <SearchBox entries={index} base={base} client:load />
  </div>

  <nav class="mt-7 rounded-2xl bg-white ring-1 ring-black/5 p-4">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-ink-muted mb-2">Jump to</h2>
    <ul class="flex flex-wrap gap-1.5 p-0 list-none">
      {groups.map((group) => (
        <li>
          <a
            href={`#letter-${group.letter}`}
            class="inline-flex min-w-8 min-h-8 items-center justify-center rounded-full bg-black/5 px-2 text-sm font-semibold text-brand transition hover:bg-pop"
          >
            {group.letter}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {groups.map((group) => (
    <section id={`letter-${group.letter}`} class="mt-10 scroll-mt-32">
      <div class="flex flex-wrap items-baseline gap-x-3 mb-4">
        <h2 class="text-2xl font-bold text-brand">{group.letter}</h2>
        <span class="text-xs text-ink-muted">{group.members.length} species</span>
      </div>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 p-0 list-none">
        {group.members.map((entry) => <SpeciesCard entry={entry} />)}
      </ul>
    </section>
  ))}
</Layout>
