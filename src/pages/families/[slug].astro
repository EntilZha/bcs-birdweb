---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SpeciesCard from "../../components/SpeciesCard.astro";
import Prose from "../../components/Prose.astro";
import { taxonomicSort } from "../../lib/species";

export async function getStaticPaths() {
  const families = await getCollection("families");
  const species = await getCollection("species");
  return families.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      members: species
        .filter((s) => s.data.family.slug === entry.id)
        .sort((a, b) => taxonomicSort(a.data, b.data)),
    },
  }));
}

const { entry, members } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={`${entry.data.name} — BirdWeb`} description={entry.data.description.slice(0, 180)}>
  <nav class="text-xs text-ink-muted mb-4">
    <a href={`${base}birds/`} class="hover:text-brand hover:underline">Birds</a>
    {entry.data.order && (
      <>
        <span aria-hidden="true"> / </span>
        <a href={`${base}orders/${entry.data.order}/`} class="hover:text-brand hover:underline capitalize">{entry.data.order}</a>
      </>
    )}
  </nav>

  <h1 class="text-3xl font-bold text-brand">{entry.data.common_name ?? entry.data.name}</h1>
  <p class="text-lg italic text-ink-muted">{entry.data.name}</p>

  {entry.data.description && (
    <div class="mt-4 max-w-3xl rounded-2xl bg-white ring-1 ring-black/5 p-5">
      <Prose text={entry.data.description} />
    </div>
  )}

  <h2 class="mt-9 text-xl font-bold text-brand">{members.length} species in Washington</h2>
  <ul class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 p-0 list-none">
    {members.map((member) => <SpeciesCard entry={member} />)}
  </ul>
</Layout>
