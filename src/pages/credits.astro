---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const species = await getCollection("species");
const sites = await getCollection("sites");

// Photographers, with the number of images each contributed. The legacy site credited
// them per-photo and nowhere else; naming them together is the least this rebuild owes
// people who gave their work to a volunteer project.
const photographers = new Map<string, { count: number; url: string | null }>();
for (const entry of [...species, ...sites]) {
  for (const photo of entry.data.photos) {
    const name = photo.credit.name?.trim();
    if (!name) continue;
    const existing = photographers.get(name);
    photographers.set(name, {
      count: (existing?.count ?? 0) + 1,
      url: existing?.url ?? photo.credit.url ?? null,
    });
  }
}
const credited = [...photographers.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const totalPhotos = credited.reduce((sum, [, v]) => sum + v.count, 0);
---

<Layout title="Credits — BirdWeb" description="The volunteers, authors, photographers and scientists who built BirdWeb.">
  <h1 class="text-3xl font-bold text-brand">Credits</h1>
  <div class="mt-3 max-w-3xl space-y-3 text-[0.9375rem] leading-relaxed text-ink">
    <p>
      BirdWeb is the work of a team of Birds Connect Seattle volunteers. The Science
      Committee has guided it since its conception in 1999. Phase I (begun July 2000,
      launched November 2002) produced the Birds and Species of Special Concern sections;
      Phase II (begun July 2004, launched November 2005) added Ecoregions, Birding Sites,
      and the recordings of bird vocalizations.
    </p>
    <p>
      The species distribution maps were created for BirdWeb by <strong>Kelly Cassidy</strong>.
      By special arrangement they were also used in <em>Birds of Washington</em>, edited by
      Terence R. Wahl, Bill Tweit and Steven G. Mlodinow (Oregon State University Press,
      2005); in exchange, BirdWeb benefited from expert review of the maps by the field
      ornithologists who wrote that book's species accounts.
    </p>
    <p>
      Thanks to <strong>Lorraine Hartmann</strong> for heading the search for the web
      volunteer team; <strong>Chris Peterson</strong> and the <strong>BirdNote</strong>
      radio program for generously providing the funds to license the sound recordings;
      <strong>Tom Munson</strong> for the bird images used in the graphic links; and the
      Board of Birds Connect Seattle for supporting this project.
      <strong>Sharon Wada</strong> provided the photo that graced the original banner.
    </p>
    <p class="rounded-xl bg-pop/25 px-4 py-3 text-sm">
      This edition was rebuilt in 2026 after the original site's source code and database
      were lost. The content here was recovered from the live site and is reproduced as the
      original authors wrote it, with current scientific names noted where taxonomy has
      changed since publication.
    </p>
  </div>

  <section class="mt-9">
    <h2 class="text-xl font-bold text-brand">Authors and production</h2>
    <div class="mt-3 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 text-sm">
      <div>
        <h3 class="font-semibold text-ink">Species accounts</h3>
        <p class="text-ink mt-1">Emily Sprong (order, family and species accounts), Hal Opperman (rarities), Jennifer Brookshier, Marti Louther, Brenda Senturia</p>
      </div>
      <div>
        <h3 class="font-semibold text-ink">Production management, Phase I</h3>
        <p class="text-ink mt-1">Hal Opperman (chair), Tom Aversa, Ellen Blackstone, Kelly Cassidy, Brenda Senturia, Ron Simons, Emily Sprong</p>
      </div>
      <div>
        <h3 class="font-semibold text-ink">Production management, Phase II</h3>
        <p class="text-ink mt-1">Helle Bielefeldt-Ohmann (chair), Tom Aversa, Ellen Blackstone, Hal Opperman, Dennis Paulson, Adam Sedgley, Brenda Senturia, Ron Simons, Margot Stiles</p>
      </div>
      <div>
        <h3 class="font-semibold text-ink">Staff project leads</h3>
        <p class="text-ink mt-1">Emily Sprong (Phase I); Adam Sedgley and Margot Stiles (Phase II)</p>
      </div>
      <div>
        <h3 class="font-semibold text-ink">Web developers, Phase I</h3>
        <p class="text-ink mt-1">Chihiro Nishihara (designer), Adam Ahringer, Kelly Crimmins, Steve Garvin, Deni Mensing, Andrea Sparling, Shang-fan Tu</p>
      </div>
      <div>
        <h3 class="font-semibold text-ink">Web developers, Phase II</h3>
        <p class="text-ink mt-1">Alan Humphrey (tech lead), Josh Freedman (tech lead), Praveen Chettypally, Liang Cui, Kristin Marshall, Madhuritha Reddy, Rochelle Ribeiro, Dean Simpson, Vanarasi Swamy, Sri Veena Syam</p>
      </div>
      <div>
        <h3 class="font-semibold text-ink">Graphic design</h3>
        <p class="text-ink mt-1">Adam Sedgley</p>
      </div>
    </div>
  </section>

  <section class="mt-9">
    <h2 class="text-xl font-bold text-brand">Photographers</h2>
    <p class="mt-1 text-sm text-ink-muted">
      {credited.length} photographers contributed the {totalPhotos} images on this site. Every
      photograph remains the property of its photographer.
    </p>
    <ul class="mt-4 grid gap-x-6 gap-y-1.5 sm:grid-cols-2 lg:grid-cols-3 p-0 list-none text-sm">
      {credited.map(([name, info]) => (
        <li class="flex items-baseline justify-between gap-3 border-b border-black/5 py-1">
          <span>
            {info.url ? (
              <a href={info.url} target="_blank" rel="noopener" class="text-brand hover:underline">{name}</a>
            ) : (
              <span class="text-ink">{name}</span>
            )}
          </span>
          <span class="text-xs text-ink-faint tabular-nums shrink-0">{info.count}</span>
        </li>
      ))}
    </ul>
  </section>
</Layout>
