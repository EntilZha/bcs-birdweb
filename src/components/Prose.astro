---
/**
 * Render the extracted account prose.
 *
 * The extractor emits Markdown-ish text: paragraphs separated by blank lines, with `*em*`
 * and `[text](url)` preserved because the volunteer authors used italics deliberately for
 * scientific names. This handles exactly that subset rather than pulling in a Markdown
 * library for four constructs -- and it escapes first, so nothing in the 2005 content can
 * inject markup.
 */
interface Props {
  text: string;
  class?: string;
}

const { text, class: className = "" } = Astro.props;

function escapeHtml(value: string): string {
  return value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function renderInline(value: string): string {
  let out = escapeHtml(value);
  // Links first: their label may itself contain emphasis markers.
  out = out.replace(
    /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
    '<a href="$2" target="_blank" rel="noopener" class="text-brand underline decoration-sage underline-offset-2 hover:decoration-brand">$1</a>',
  );
  out = out.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
  out = out.replace(/\*([^*]+)\*/g, "<em>$1</em>");
  return out;
}

// The ported static pages carry `## headings`; species accounts never do, so this costs
// nothing there and keeps those pages' structure instead of flattening it to paragraphs.
const blocks = text
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean)
  .map((block) => {
    const heading = /^(#{2,3})\s+(.*)$/.exec(block);
    return heading
      ? { kind: `h${heading[1].length}` as "h2" | "h3", text: heading[2] }
      : { kind: "p" as const, text: block };
  });
---

<div class:list={["space-y-3 text-[0.9375rem] leading-relaxed text-ink", className]}>
  {
    blocks.map((block) =>
      block.kind === "h2" ? (
        <h2 class="text-xl font-bold text-brand pt-3" set:html={renderInline(block.text)} />
      ) : block.kind === "h3" ? (
        <h3 class="text-base font-bold text-brand pt-2" set:html={renderInline(block.text)} />
      ) : (
        <p set:html={renderInline(block.text)} />
      ),
    )
  }
</div>
