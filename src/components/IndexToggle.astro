---
interface Props {
  /** Which ordering the current page shows. */
  current: "family" | "alpha";
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL;

/**
 * Taxonomic ⇄ alphabetical, as two static routes rather than a client-side toggle.
 *
 * The two orderings are structurally different, not just re-sorted: by family carries 64
 * group headings and a jump-to-family nav, A–Z carries 26 letter headings. Rendering both
 * into one page and hiding one would double 613KB of markup; making it an island would
 * ship all 491 records as JSON on top of the HTML that already contains them. Two
 * prerendered pages cost nothing at runtime and work with JavaScript off.
 */
const OPTIONS = [
  { key: "family", label: "By family", href: `${base}birds/` },
  { key: "alpha", label: "A–Z", href: `${base}birds/a-z/` },
] as const;
---

<div class="inline-flex rounded-full bg-black/5 p-1" role="group" aria-label="Sort order">
  {
    OPTIONS.map((option) =>
      option.key === current ? (
        <span
          aria-current="true"
          class="rounded-full bg-brand px-4 py-1.5 text-xs font-semibold text-white"
          >{option.label}</span
        >
      ) : (
        <a
          href={option.href}
          class="rounded-full px-4 py-1.5 text-xs font-semibold text-ink transition hover:bg-black/5 hover:text-brand"
          >{option.label}</a
        >
      ),
    )
  }
</div>
