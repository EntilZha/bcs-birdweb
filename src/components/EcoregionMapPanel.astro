---
import type { CollectionEntry } from "astro:content";
import shapes from "../data/ecoregion-shapes.json";
import { ECOREGIONS, ECOREGION_NAME, type EcoregionSlug } from "../config/ecoregions";
import { mappableSites, countByConfidence } from "../lib/sites";
import EcoregionLeaflet, {
  type RegionShape,
  type SitePin,
} from "./EcoregionLeaflet.tsx";

interface Props {
  sites?: CollectionEntry<"sites">[];
  active?: EcoregionSlug;
  class?: string;
}

const { sites = [], active, class: className = "" } = Astro.props;
const base = import.meta.env.BASE_URL;

/**
 * One fill per ecoregion, chosen by scripts/assign_ecoregion_colours.py.
 *
 * A choropleth is normally held to *all-pairs* colour separation, since any two categories
 * can land side by side in a legend — and under simulated protanopia and deuteranopia only
 * about three hues clear that bar, which is why this map used to have three. But a map is
 * not a legend: these ten regions have fixed positions, so the pairs that actually need to
 * be told apart are the ones that share a border. The script searches assignments to
 * maximise the weakest *geographically adjacent* pair; the worst neighbouring pair here is
 * ΔE 15.2, comfortably past the target of 8.
 *
 * Non-adjacent regions may resemble each other, which is the deliberate trade. Identity
 * never rests on colour: every region is numbered on the map, as the original was, and the
 * legend below is server-rendered with both the swatch and the name.
 */
const regionFill = shapes.region_fill as Record<string, string>;
const FALLBACK_FILL = "#2a78d6";
// Generated by scripts/extract_ecoregion_shapes.py as [lon, lat] pairs; a JSON import
// widens that to number[][], which no cast can narrow directly.
const rings = shapes.regions as unknown as Record<string, [number, number][]>;
const labelPoints = shapes.label_points as unknown as Record<string, [number, number]>;
const ORDER = ECOREGIONS.map((e) => e.slug);

const regions: RegionShape[] = ORDER.filter((slug) => rings[slug]).map((slug) => ({
  slug,
  name: ECOREGION_NAME[slug],
  number: ORDER.indexOf(slug),
  ring: rings[slug],
  labelAt: labelPoints[slug],
  fill: regionFill[slug] ?? FALLBACK_FILL,
}));

const pins: SitePin[] = mappableSites(sites).map((pin) => ({
  slug: pin.site.id,
  name: pin.site.data.name,
  lat: pin.lat,
  lon: pin.lon,
  confirmed: pin.confidence === "confirmed",
}));
const { approximate } = countByConfidence(sites);

// Built here rather than interleaved in the template: adjacent JSX expressions get a
// space between them, which puts one before the comma and the full stop.
const pinSummary =
  pins.length === 0
    ? null
    : `${pins.length} birding sites shown` +
      (approximate > 0 ? `, ${approximate} at approximate locations still to be checked` : "") +
      ".";
---

<div class:list={[className]}>
  <!-- client:only, not client:visible: Leaflet reads `window` at module scope, so Astro
       cannot even import it to prerender the island's initial HTML. Nothing is lost —
       the region list below is server-rendered, so the page is navigable before (and
       without) any JavaScript. The reserved height keeps the list from jumping when the
       map mounts. -->
  <div style="min-height:clamp(24rem,58vh,40rem)">
    <EcoregionLeaflet
      regions={regions}
      sites={pins}
      base={base}
      active={active}
      client:only="react"
    />
  </div>

  <!-- Server-rendered, so the regions are navigable before the island hydrates, with
       JavaScript off, and if the tiles never load. A legend is always present and every
       region is also labelled on the map, so identity is never colour alone. -->
  <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 p-0 list-none text-xs">
    {
      ORDER.map((slug, i) => (
        <li>
          <a
            href={`${base}ecoregions/${slug}/`}
            class:list={[
              "inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 transition hover:bg-black/5",
              active === slug ? "bg-pop text-brand font-semibold" : "text-ink",
            ]}
          >
            <span
              class="inline-block h-3 w-3 shrink-0 rounded-sm ring-1 ring-black/10"
              style={`background:${regionFill[slug] ?? FALLBACK_FILL}`}
              aria-hidden="true"
            />
            <span class="tabular-nums text-ink-muted">{i}</span>
            {ECOREGION_NAME[slug]}
          </a>
        </li>
      ))
    }
  </ul>

  {pinSummary && <p class="mt-2 text-xs text-ink-muted">{pinSummary}</p>}
</div>
